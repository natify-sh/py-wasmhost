(module
  (import "wasi:cli/stdout@0.2.6" "get-stdout" (func $getout (result i32)))
  (import "wasi:io/streams@0.2.6" "[method]output-stream.blocking-write-and-flush" (func $bwf (param i32 i32 i32 i32)))
  (import "wasi:cli/environment@0.2.6" "get-environment" (func $env (param i32)))
  (import "wasi:random/random@0.2.6" "get-random-bytes" (func $rnd (param i64 i32)))
  (import "wasi:cli/exit@0.2.6" "exit" (func $exit (param i32)))
  (memory (export "memory") 1)
  (global $brk (mut i32) (i32.const 4096))
  (data (i32.const 16) "hello from wasip2\n")
  (func (export "cabi_realloc") (param $o i32) (param $os i32) (param $al i32) (param $n i32) (result i32)
    (local $p i32)
    (local.set $p (i32.and (i32.add (global.get $brk) (i32.sub (local.get $al) (i32.const 1)))
                           (i32.sub (i32.const 0) (local.get $al))))
    (global.set $brk (i32.add (local.get $p) (local.get $n)))
    (local.get $p))
  (func (export "wasi:cli/run@0.2.6#run") (result i32)
    (call $bwf (call $getout) (i32.const 16) (i32.const 18) (i32.const 64))
    (call $rnd (i64.const 8) (i32.const 96))
    (call $env (i32.const 112))
    ;; result tag at 64: 0 = ok
    (i32.load8_u (i32.const 64)))
  (func (export "exit1") (call $exit (i32.const 1)))
)
