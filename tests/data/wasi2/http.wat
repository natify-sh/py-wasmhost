(module
  (import "wasi:cli/stdout@0.2.6" "get-stdout" (func $getout (result i32)))
  (import "wasi:io/streams@0.2.6" "[method]output-stream.blocking-write-and-flush" (func $bwf (param i32 i32 i32 i32)))
  (import "wasi:http/types@0.2.6" "[method]incoming-response.status" (func $status (param i32) (result i32)))
  (import "wasi:http/types@0.2.6" "[constructor]fields" (func $fields (result i32)))
  (import "wasi:http/types@0.2.6" "[constructor]outgoing-request" (func $req (param i32) (result i32)))
  (import "wasi:http/types@0.2.6" "[method]outgoing-request.set-scheme" (func $scheme (param i32 i32 i32 i32 i32) (result i32)))
  (import "wasi:http/types@0.2.6" "[method]outgoing-request.set-authority" (func $auth (param i32 i32 i32 i32) (result i32)))
  (import "wasi:http/types@0.2.6" "[method]outgoing-request.set-path-with-query" (func $path (param i32 i32 i32 i32) (result i32)))
  (import "wasi:http/outgoing-handler@0.2.6" "handle" (func $handle (param i32 i32 i32 i32)))
  (import "wasi:http/types@0.2.6" "[method]future-incoming-response.get" (func $get (param i32 i32)))
  (memory (export "memory") 1)
  (global $brk (mut i32) (i32.const 4096))
  (data (i32.const 16) "127.0.0.1:47124")
  (data (i32.const 32) "/x?q=1")
  (func (export "cabi_realloc") (param $o i32) (param $os i32) (param $al i32) (param $n i32) (result i32)
    (local $p i32)
    (local.set $p (i32.and (i32.add (global.get $brk) (i32.sub (local.get $al) (i32.const 1)))
                           (i32.sub (i32.const 0) (local.get $al))))
    (global.set $brk (i32.add (local.get $p) (local.get $n)))
    (local.get $p))
  (func (export "wasi:cli/run@0.2.6#run") (result i32)
    (local $r i32) (local $s i32)
    (local.set $r (call $req (call $fields)))
    (drop (call $scheme (local.get $r) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 0)))
    (drop (call $auth (local.get $r) (i32.const 1) (i32.const 16) (i32.const 15)))
    (drop (call $path (local.get $r) (i32.const 1) (i32.const 32) (i32.const 6)))
    ;; result<future, error-code> at 64: tag 0 = ok (handle at 72), 1 = err
    (call $handle (local.get $r) (i32.const 0) (i32.const 0) (i32.const 64))
    (if (i32.eqz (i32.load8_u (i32.const 64)))
      (then
        ;; option<result<result<response, error-code>>> at 128: tags at 128, 136, 144; the response handle at 152
        (call $get (i32.load (i32.const 72)) (i32.const 128))
        (if (i32.and (i32.and (i32.load8_u (i32.const 128)) (i32.eqz (i32.load8_u (i32.const 136))))
                     (i32.eqz (i32.load8_u (i32.const 144))))
          (then
            ;; the status as three ASCII digits at 200, written to stdout
            (local.set $s (call $status (i32.load (i32.const 152))))
            (i32.store8 (i32.const 200) (i32.add (i32.const 48) (i32.div_u (local.get $s) (i32.const 100))))
            (i32.store8 (i32.const 201) (i32.add (i32.const 48) (i32.rem_u (i32.div_u (local.get $s) (i32.const 10)) (i32.const 10))))
            (i32.store8 (i32.const 202) (i32.add (i32.const 48) (i32.rem_u (local.get $s) (i32.const 10))))
            (call $bwf (call $getout) (i32.const 200) (i32.const 3) (i32.const 64))
            (i32.store8 (i32.const 64) (i32.const 0))))))
    (i32.load8_u (i32.const 64)))
)
