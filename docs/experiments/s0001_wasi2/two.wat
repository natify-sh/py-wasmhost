(module
  (import "wasi:cli/stdout@0.2.6" "get-stdout" (func $getout (result i32)))
  (import "wasi:io/streams@0.2.6" "[method]output-stream.blocking-write-and-flush" (func $bwf (param i32 i32 i32 i32)))
  (import "wasi:cli/environment@0.2.6" "get-environment" (func $env (param i32)))
  (memory (export "memory") 1)
  (memory (export "memory$1") 1)
  (global $brk (mut i32) (i32.const 4096))
  (data (i32.const 16) "hello from wasip2\n")
  (func (export "cabi_realloc") (param $o i32) (param $os i32) (param $al i32) (param $n i32) (result i32)
    (local $p i32)
    (local.set $p (i32.and (i32.add (global.get $brk) (i32.sub (local.get $al) (i32.const 1))) (i32.sub (i32.const 0) (local.get $al))))
    (global.set $brk (i32.add (local.get $p) (local.get $n)))
    (local.get $p))
  (func (export "cabi_realloc$1") (param $o i32) (param $os i32) (param $al i32) (param $n i32) (result i32)
    (i32.const 8192))
  ;; component 1 calls environment: result goes into memory 1 (the flat import has no memory index; comp must come from the host)
  (func (export "env1") (call $env (i32.const 112)))
  (func (export "env0") (call $env (i32.const 112)))
)
